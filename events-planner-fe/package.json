    "jsdom": "^29.1.0",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "msw": "^2.7.6",
    "postcss": "^8.5.12",
    "prettier": "^3.5.3",
    "react-router": "^7.14.2",
    "sass": "^1.87.0",
    "tailwindcss": "^4.2.4",
